<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the energy tracker: a label plus five tappable stars.
     Colours come from theme attributes so it stays readable in both modes;
     the filled/unfilled state is set at runtime in ReviewActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/energyLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/energyStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

</LinearLayout>
