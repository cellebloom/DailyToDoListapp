<?xml version="1.0" encoding="utf-8"?>
<!-- One day cell in the horizontal day selector: weekday abbreviation on top,
     day of month below. The background and text colours are set in
     DaySelectorAdapter so the selected cell can use the live theme accent,
     which is only known at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayTabRoot"
    android:layout_width="56dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/day_tab_bg">

    <TextView
        android:id="@+id/dayTabWeekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/dayTabDayOfMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>
