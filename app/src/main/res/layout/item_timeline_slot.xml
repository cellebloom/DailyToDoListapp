<?xml version="1.0" encoding="utf-8"?>
<!-- One hour row on the timeline: time label on the left, task blocks on the
     right. Text colours are theme attributes so this stays readable in both
     light and dark mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="64dp">

    <TextView
        android:id="@+id/slotTimeLabel"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:gravity="end|top"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Blocks starting in this hour are added here. -->
        <LinearLayout
            android:id="@+id/slotBlocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="?attr/colorOutline" />
    </LinearLayout>

</LinearLayout>
