<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header Section: title on the start, sleek AI entry at the far end. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="24dp"
        android:paddingRight="16dp"
        android:paddingTop="25dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <!-- Icon-only, circular MaterialButton. TonalButton supplies a real
             filled container; overriding its tint with colorPrimary gives the
             sleek accent disc. With no text, iconGravity="textStart" centres
             the drawable. All colours are theme attrs, never hex. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskAi"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:icon="@drawable/ic_ai_sparkle"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="24dp"
            app:elevation="6dp"
            android:contentDescription="@string/ask_ai" />

    </LinearLayout>

    <!-- Main Content. A FrameLayout so the timeline's FAB can float over the
         scrolling content instead of sitting in the scroll flow. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="20dp">

            <!-- Date Card -->
            <LinearLayout
                android:id="@+id/dateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/white_card_bg"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026.05.23"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary"
                    android:layout_gravity="center" />

            </LinearLayout>

            <!-- Today's Tasks Card -->
            <LinearLayout
                android:id="@+id/tasksCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="550dp"
                android:orientation="vertical"
                android:background="@drawable/white_card_bg"
                android:padding="20dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tasksHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/todays_tasks"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Top 3 Priorities. Hidden entirely when the day has none. -->
                <LinearLayout
                    android:id="@+id/prioritiesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/prioritiesHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/top_priorities_header"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/prioritiesContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- List / Timeline switch. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/viewToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnListView"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/view_list"
                        android:textSize="14sp"
                        android:checked="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimelineView"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/view_timeline"
                        android:textSize="14sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/tasksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/noTasksLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="80dp"
                        android:paddingBottom="80dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="📋"
                            android:textSize="56sp" />

                        <TextView
                            android:id="@+id/noTasksText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_tasks_today"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/theme_text_primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/take_a_break"
                            android:textSize="13sp"
                            android:textColor="@color/theme_text_secondary"
                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tasksListLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- Backlog: Anytime tasks, which have no interval. -->
                    <LinearLayout
                        android:id="@+id/backlogSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/backlogHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backlog_header"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:id="@+id/backlogContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <!-- AI auto-schedule. Lives in the backlog section, so it
                             only appears when there are Anytime tasks to move
                             onto the grid. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAutoSchedule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_auto_schedule"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp" />

                    </LinearLayout>

                    <!-- Horizontal day selector -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/daySelectorRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:visibility="gone" />

                    <!-- Inline empty hint for the timeline. -->
                    <TextView
                        android:id="@+id/timelineEmptyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_tasks_scheduled_hint"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />

                    <!-- Softer day header: a calendar glyph plus "Thu, Nov 12"
                         in a rounded pill, replacing the rigid TIME | THU
                         table band. The date text is filled in at runtime from
                         the selected ISO date (bindTimelineHeader). -->
                    <LinearLayout
                        android:id="@+id/timelineHeaderRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_day_header_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="7dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar_small"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/timelineHeaderDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Timeline view. -->
                    <com.example.dailytodolist.WrapHeightRecyclerView
                        android:id="@+id/timelineRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingBottom="32dp"
                        android:clipToPadding="false"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/todo_divider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Opens the Add Task page. Replaces the old inline text field,
                     which looked like it saved in place but actually navigated
                     away, so the typed text was thrown away.

                     app:backgroundTint="@null" is required: without it the
                     MaterialButton style's colorPrimary tint is re-applied on top
                     of the gradient installed in code, so the button renders as
                     flat blue instead of blue-to-purple. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addTaskButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/add_task_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@null"
                    app:cornerRadius="26dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

            </LinearLayout>

            <!-- Inspirational Quote Card -->
            <LinearLayout
                android:id="@+id/quoteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/white_card_bg"
                android:padding="20dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/quoteLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/daily_quote"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/editQuoteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit"
                        android:textSize="12sp"
                        android:textColor="?attr/colorPrimary"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <TextView
                    android:id="@+id/quoteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_quote"
                    android:textSize="18sp"
                    android:textStyle="italic"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/quoteAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_quote_author"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_gravity="center" />

            </LinearLayout>

            <!-- End of Day Review entry. The gradient comes from
                 GradientHelper.applyPill() in MainActivity, like the Add Task
                 button, so this pill follows the theme instead of a fixed
                 purple fill. textColor here is only the pre-theme fallback. -->
            <TextView
                android:id="@+id/openReviewButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="@string/open_review"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                android:textColor="?attr/colorOnPrimary" />

        </LinearLayout>

    </ScrollView>

    <!-- Timeline FAB: floats over the content, bottom-right, and is only
         visible in Timeline view (MainActivity#setTimelineView). The gradient
         fill is applied in code with GradientHelper.applyPill so it matches the
         active theme, which a static backgroundTint cannot express. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/add_task_title"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorPrimary"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="normal"
        app:tint="?attr/colorOnPrimary"
        android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navCalendarText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_calendar"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navShopText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_shop"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navThemes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navThemesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_themes"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>