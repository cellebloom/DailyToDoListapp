<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="25dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="20dp">

            <!-- Date Card -->
            <LinearLayout
                android:id="@+id/dateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/white_card_bg"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026.05.23"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary"
                    android:layout_gravity="center" />

            </LinearLayout>

            <!-- Today's Tasks Card -->
            <LinearLayout
                android:id="@+id/tasksCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="550dp"
                android:orientation="vertical"
                android:background="@drawable/white_card_bg"
                android:padding="20dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tasksHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/todays_tasks"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Top 3 Priorities. Hidden entirely when the day has none,
                     so the section never renders as an empty shell. -->
                <LinearLayout
                    android:id="@+id/prioritiesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/prioritiesHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/top_priorities_header"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/prioritiesContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- List / Timeline switch. Colours come from theme attributes
                     so it follows light and dark mode like the rest of the card. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/viewToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnListView"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/view_list"
                        android:textSize="14sp"
                        android:checked="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimelineView"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/view_timeline"
                        android:textSize="14sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Height must wrap the content, not take weight: this card is
                     wrap_content with a minHeight, so a 0dp/weight child would be
                     squeezed into whatever the 550dp floor leaves over and clip
                     the timeline to about five hours. -->
                <LinearLayout
                    android:id="@+id/tasksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/noTasksLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="80dp"
                        android:paddingBottom="80dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="📋"
                            android:textSize="56sp" />

                        <TextView
                            android:id="@+id/noTasksText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_tasks_today"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/theme_text_primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/take_a_break"
                            android:textSize="13sp"
                            android:textColor="@color/theme_text_secondary"
                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tasksListLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- Backlog: Anytime tasks, which have no interval and so
                         cannot be positioned on the hour grid. -->
                    <LinearLayout
                        android:id="@+id/backlogSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/backlogHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backlog_header"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:id="@+id/backlogContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Horizontal day selector, like the top row of a paper
                         planner. Sits above the grid and drives which date the
                         timeline renders. hidden in List view. -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/daySelectorRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:visibility="gone" />

                    <!-- Inline empty hint for the timeline. Shown only when the
                         day has no scheduled tasks; the hour grid below it
                         stays visible so the view still reads as a timeline
                         rather than a blank or broken screen. -->
                    <TextView
                        android:id="@+id/timelineEmptyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_tasks_scheduled_hint"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />

                    <!-- Timeline view. Only scheduled tasks are laid out here;
                         Anytime tasks stay in the list, because they have no
                         interval to position on a time axis.

                         WrapHeightRecyclerView (not a plain RecyclerView) is
                         required: wrap_content alone still clamps to the
                         viewport under an AT_MOST parent spec, which truncated
                         the grid at about 14:00. It measures against
                         UNSPECIFIED so all 18 hours from 06:00 to 23:00 are
                         laid out and the outer ScrollView can reach the end. -->
                    <com.example.dailytodolist.WrapHeightRecyclerView
                        android:id="@+id/timelineRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingBottom="32dp"
                        android:clipToPadding="false"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Divider WITH ID -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/todo_divider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/newTaskInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="@string/add_new_task_hint"
                        android:textSize="14sp"
                        android:textColor="@color/theme_text_primary"
                        android:background="@drawable/input_field_bg"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                    <TextView
                        android:id="@+id/addTaskButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/add"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:layout_marginStart="12dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Inspirational Quote Card -->
            <LinearLayout
                android:id="@+id/quoteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/white_card_bg"
                android:padding="20dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/quoteLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/daily_quote"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/theme_accent" />

                    <TextView
                        android:id="@+id/editQuoteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit"
                        android:textSize="12sp"
                        android:textColor="@color/theme_accent"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Quote Text -->
                <TextView
                    android:id="@+id/quoteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_quote"
                    android:textSize="18sp"
                    android:textStyle="italic"
                    android:textColor="@color/theme_text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center" />

                <!-- Quote Author -->
                <TextView
                    android:id="@+id/quoteAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_quote_author"
                    android:textSize="14sp"
                    android:textColor="@color/theme_accent"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_gravity="center" />

            </LinearLayout>

            <!-- End of Day Review entry -->
            <TextView
                android:id="@+id/openReviewButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="@string/open_review"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/action_button_bg"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- Home - Active -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textSize="12sp"
                android:textColor="#9C27B0"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Calendar -->
        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navCalendarText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_calendar"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shop -->
        <LinearLayout
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navShopText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_shop"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Themes -->
        <LinearLayout
            android:id="@+id/navThemes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navThemesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_themes"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/navProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>