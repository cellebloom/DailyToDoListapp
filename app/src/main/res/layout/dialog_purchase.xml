<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="28dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Purchase Theme"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/default_text_primary_light"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/coinsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="150"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/default_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/streakText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Spend 150 coins to unlock this theme?"
        android:textSize="14sp"
        android:textColor="@color/base_text_secondary"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/base_text_secondary"
            android:gravity="center"
            android:background="@drawable/input_field_bg"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/claimButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="PURCHASE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:background="@drawable/action_button_bg"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>
