<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Material 3 Theme -->
    <style name="Base.Theme.DailyToDoList" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/default_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/default_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/default_start</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Modern Login Theme -->
    <style name="Theme.DailyToDoList.Login" parent="Base.Theme.DailyToDoList">
        <item name="colorPrimary">@color/login_button_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/login_forgot_password</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/login_bg</item>
        <item name="android:colorBackground">@color/login_card_bg</item>
        <item name="android:textColorPrimary">@color/login_text_primary</item>
        <item name="android:textColorSecondary">@color/login_text_secondary</item>
        <item name="android:statusBarColor">@color/default_start</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorControlNormal">#6B8DB5</item>
        <item name="colorControlActivated">@color/login_remember_me</item>
    </style>

