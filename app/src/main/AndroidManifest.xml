<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- For Android 13+ (API 33) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Time-block reminders. POST_NOTIFICATIONS is runtime-granted on
         Android 13+; SCHEDULE_EXACT_ALARM lets the reminder land on the exact
         minute instead of whenever the system feels like batching it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Base.Theme.DailyToDoList"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="31">

        <!-- Login Activity with Modern Theme -->
        <activity
            android:name=".LoginActivity"
            android:theme="@style/Theme.DailyToDoList.Login"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- Calendar Activity -->
        <activity
            android:name=".CalendarActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- Profile Activity -->
        <activity
            android:name=".ProfileActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- Shop Activity -->
        <activity
            android:name=".ShopActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- Theme Activity -->
        <activity
            android:name=".ThemeActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- Add Task Activity -->
        <activity
            android:name=".AddTaskActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- End of day review -->
        <activity
            android:name=".ReviewActivity"
            android:theme="@style/Base.Theme.DailyToDoList"
            android:configChanges="uiMode|screenLayout|screenSize|orientation|locale"
            android:exported="false" />

        <!-- Delivers "starts in 5 minutes" notifications. Not exported: only
             our own AlarmManager intents reach it. -->
        <receiver
            android:name=".TaskReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.dailytodolist.TASK_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Alarms do not survive a reboot, so re-arm them on boot. -->
        <receiver
            android:name=".BootReminderReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- File Provider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.dailytodolist.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>